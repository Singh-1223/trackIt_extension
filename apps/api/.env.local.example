# ===========================================
# TrackIt API Server — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.

# MongoDB connection string (MongoDB Atlas or local)
# Get this from: https://cloud.mongodb.com → Database → Connect
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/trackit?retryWrites=true&w=majority

# Clerk authentication (get from https://dashboard.clerk.com → API Keys)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
