{
  "expo": {
    "name": "TrackIt",
    "slug": "trackit",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "trackit",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f5efe5"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f5efe5"
      },
      "package": "com.trackit.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "95b69a77-1d99-4744-8300-8d6e9dfe5b03"
      }
    }
  }
}
