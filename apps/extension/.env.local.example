# ===========================================
# TrackIt Extension — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# These are injected at build time via Vite (prefix: VITE_)

# Clerk publishable key (same as API's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY)
# Get from: https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API server URL (where your Next.js backend is running)
# Local dev: http://localhost:3000
# Production: https://your-api-domain.com
VITE_API_URL=http://localhost:3000
