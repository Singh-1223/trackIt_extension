{
  "manifest_version": 3,
  "name": "TrackIt",
  "version": "1.0.0",
  "description": "Daily tracker with task groups, checkboxes, and history.",
  "permissions": ["storage"],
  "options_page": "dist/options.html",
  "action": {
    "default_title": "TrackIt",
    "default_popup": "dist/popup.html"
  },
  "minimum_chrome_version": "114"
}
