{
  "name": "trackit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/extension",
    "apps/api"
  ],
  "scripts": {
    "dev:extension": "npm run dev --workspace=@trackit/extension",
    "dev:api": "npm run dev --workspace=@trackit/api",
    "build:extension": "npm run build --workspace=@trackit/extension",
    "build:api": "npm run build --workspace=@trackit/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "dev": "npm run dev:extension & npm run dev:api"
  }
}
